{
  "panelFamily": "ii",
  "policies": {
    "ai": 0,
    "weeb": 0
  },
  "appearance": {
    "extraBackgroundTint": false,
    "fakeScreenRounding": 0,
    "fonts": {
      "main": "Noto Sans",
      "numbers": "Noto Sans",
      "title": "Noto Sans",
      "iconNerd": "MesloLGS Nerd Font",
      "monospace": "MesloLGS Nerd Font",
      "reading": "Noto Sans",
      "expressive": "Noto Sans"
    },
    "transparency": {
      "enable": true,
      "automatic": false,
      "backgroundTransparency": 0.06,
      "contentTransparency": 0.9
    },
    "wallpaperTheming": {
      "enableAppsAndShell": false,
      "enableQtApps": false,
      "enableTerminal": false
    },
    "palette": {
      "type": "scheme-tonal-spot",
      "accentColor": "#C62828"
    }
  },
  "background": {
    "wallpaperPath": "@WALLPAPER@",
    "widgets": {
      "clock": {
        "enable": false
      },
      "weather": {
        "enable": false
      }
    },
    "parallax": {
      "enableWorkspace": false,
      "enableSidebar": false
    }
  },
  "apps": {
    "terminal": "@KITTY@",
    "bluetooth": "kcmshell6 kcm_bluetooth",
    "network": "kcmshell6 kcm_networkmanagement",
    "networkEthernet": "kcmshell6 kcm_networkmanagement",
    "taskManager": "plasma-systemmonitor --page-name Processes",
    "manageUser": "kcmshell6 kcm_users"
  },
  "bar": {
    "cornerStyle": 1,
    "verbose": true,
    "workspaces": {
      "shown": 10,
      "showAppIcons": true,
      "monochromeIcons": true
    }
  },
  "light": {
    "night": {
      "automatic": false
    }
  },
  "conflictKiller": {
    "autoKillTrays": false,
    "autoKillNotificationDaemons": false
  },
  "notifications": {
    "monitor": {
      "enable": false,
      "name": ""
    }
  }
}
