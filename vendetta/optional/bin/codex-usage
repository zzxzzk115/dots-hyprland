#!/usr/bin/env python3
import os,sys,json,time,subprocess,select,fcntl,math,html
from pathlib import Path
BASE=Path.home()/'.cache/codex-usage'; CACHE=BASE/'usage.json'
def read():
 try:return json.loads(CACHE.read_text())
 except (OSError,ValueError):return {}
def normalize(raw):
 buckets=raw.get('rateLimitsByLimitId')
 if not buckets:
  r=raw.get('rateLimits');buckets={r.get('limitId') or 'codex':r} if r else {}
 rows=[]
 for key,b in buckets.items():
  if not b:continue
  for slot in ('primary','secondary'):
   w=b.get(slot)
   if not w or w.get('usedPercent') is None:continue
   used=float(w['usedPercent'])
   if not math.isfinite(used):continue
   mins=w.get('windowDurationMins');label='Weekly limit' if mins==10080 else '5-hour limit' if mins==300 else str(mins)+'-minute limit' if mins else 'Usage'
   rows.append({'id':str(key)+':'+slot,'windowDurationMins':mins,'name':('' if key=='codex' else (b.get('limitName') or key)+' · ')+label,'remaining':max(0,min(100,100-used)),'resetsAt':w.get('resetsAt')})
 return rows
def fetch():
 BASE.mkdir(parents=True,exist_ok=True);lock=(BASE/'lock').open('w')
 try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
 except BlockingIOError:return
 old=read();p=None
 try:
  env=os.environ.copy()
  for k in ('LD_LIBRARY_PATH','QT_PLUGIN_PATH','QML_IMPORT_PATH'):env.pop(k,None)
  p=subprocess.Popen(['/usr/lib/chatgpt/resources/codex','app-server'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,env=env)
  def send(x):p.stdin.write((json.dumps(x)+'\n').encode());p.stdin.flush()
  send({'id':1,'method':'initialize','params':{'clientInfo':{'name':'desktop_usage_widget','version':'1.0'}}})
  pending=b'';deadline=time.monotonic()+35;result=None
  while time.monotonic()<deadline and result is None:
   if not select.select([p.stdout],[],[],1)[0]:continue
   chunk=os.read(p.stdout.fileno(),65536)
   if not chunk:raise RuntimeError('service unavailable')
   pending+=chunk
   while b'\n' in pending:
    line,pending=pending.split(b'\n',1);msg=json.loads(line)
    if msg.get('id')==1:
     if 'error' in msg:raise RuntimeError('initialization failed')
     send({'method':'initialized'});send({'id':2,'method':'account/rateLimits/read'})
    if msg.get('id')==2:
     if 'error' in msg:raise RuntimeError('Unable to read quota; check login or network')
     result=msg['result']
  if result is None:raise RuntimeError('request timeout')
  rows=normalize(result)
  if not rows:raise RuntimeError('no quota data returned')
  old={'updated':time.time(),'windows':rows,'error':None}
 except Exception:
  old['error']='Usage could not be updated. Check your network or ChatGPT sign-in.'
 finally:
  if p:
   p.terminate()
   try:p.wait(timeout=3)
   except subprocess.TimeoutExpired:p.kill();p.wait()
 temp=BASE/'usage.tmp';temp.write_text(json.dumps(old,ensure_ascii=False));temp.chmod(0o600);temp.replace(CACHE)
def status():
 d=read();rows=d.get('windows',[]);updated=d.get('updated',0)
 stale=bool(d.get('error')) or time.time()-updated>600 or any(w.get('resetsAt') and time.time()>w['resetsAt'] for w in rows)
 value=min((w['remaining'] for w in rows),default=None)
 cls='stale' if stale else 'critical' if value is not None and value<10 else 'warning' if value is not None and value<20 else 'normal'
 lines=['Codex remaining usage']
 for w in rows:
  reset=time.strftime('%m-%d %H:%M %Z',time.localtime(w['resetsAt'])) if w.get('resetsAt') else 'Unknown'
  lines+=['%s: %g%%\nResets: %s'%(w['name'],w['remaining'],reset)]
 lines+=['Updated: '+(time.strftime('%m-%d %H:%M:%S',time.localtime(updated)) if updated else 'Not fetched yet')]
 if stale:lines+=['Data is stale' if rows else 'No usage data available',d.get('error') or 'Waiting for refresh']
 detail='\n\n'.join(lines)
 for old,new in {'额度暂时无法更新，请检查网络或 ChatGPT 登录状态。': 'Usage could not be updated. Check your network or ChatGPT sign-in.', 'Codex 剩余额度': 'Codex remaining usage', '周额度': 'Weekly limit', '5 小时额度': '5-hour limit', ' 分钟额度': '-minute limit', '尚未获取': 'Not fetched yet', '暂无额度数据': 'No usage data available', '数据已过期': 'Data is stale', '等待刷新': 'Waiting for refresh', '刷新额度': 'Refresh usage', '打开 ChatGPT': 'Open ChatGPT', 'Codex 额度': 'Codex usage', '未知': 'Unknown', '重置：': 'Resets: ', '更新：': 'Updated: ', '额度': 'Usage'}.items():detail=detail.replace(old,new)
 return {'text':str(round(value))+'%' if value is not None else '—','tooltip':html.escape(detail),'detail':detail,'class':cls,'percentage':value or 0,'remaining':value,'stale':stale}
def refresh():subprocess.Popen(['systemctl','--user','start','--no-block','codex-usage.service'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
def dialog():
 while True:
  r=subprocess.run(['kdialog','--title','Codex usage','--menu',status()['detail'],'refresh','Refresh usage','open','Open ChatGPT'],capture_output=True,text=True)
  if r.returncode:return
  if r.stdout.strip()=='open':subprocess.Popen([str(Path.home()/'.local/bin/chatgpt')],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL);return
  refresh();time.sleep(2)
# Helpers appended to the existing account reader. No prompts or model calls.
SETTINGS = Path.home()/'.config/codex-usage/widget.json'

def load_json(path, default):
 try:return json.loads(path.read_text())
 except (OSError, ValueError):return default

def write_json(path, value):
 path.parent.mkdir(parents=True,exist_ok=True)
 temp=path.with_suffix('.tmp')
 temp.write_text(json.dumps(value));temp.chmod(0o600);temp.replace(path)

def preferences():
 return {'enabled':True,'snoozedUntil':0,**load_json(SETTINGS,{})}

def countdown(seconds):
 if seconds is None:return 'Unknown'
 if seconds<=0:return 'Awaiting refresh'
 minutes=max(1,math.ceil(seconds/60))
 days,minutes=divmod(minutes,1440);hours,minutes=divmod(minutes,60)
 return (f'{days}d ' if days else '')+(f'{hours}h ' if hours else '')+f'{minutes}m'

def action(name):
 if name=='open':subprocess.Popen([str(Path.home()/'.local/bin/chatgpt')]);return
 if name=='usage':subprocess.Popen(['xdg-open','https://chatgpt.com/codex/settings/usage']);return
 if name=='refresh':refresh();return
 if name in ('toggle-reminders','snooze','resume'):
  prefs=preferences()
  if name=='toggle-reminders':prefs['enabled']=not prefs['enabled']
  elif name=='snooze':prefs['snoozedUntil']=time.time()+86400
  else:prefs.update(enabled=True,snoozedUntil=0)
  write_json(SETTINGS,prefs);return
 raise SystemExit('Unknown action')

legacy_status=status

def status():
 out=legacy_status();data=read();now=time.time();rows=[]
 for w in data.get('windows',[]):
  reset=w.get('resetsAt');seconds=reset-now if isinstance(reset,(int,float)) else None
  rows.append({**w,'countdown':countdown(seconds),'resetTime':time.strftime('%m-%d %H:%M %Z',time.localtime(reset)) if reset else 'Unknown'})
 prefs=preferences()
 out.update(windows=rows,remindersEnabled=prefs['enabled'],snoozed=prefs['snoozedUntil']>now,updated=data.get('updated',0))
 if not out['stale']:
  out['detail']+='\n\n'+'\n'.join(w['name']+': resets in '+w['countdown'] for w in rows)
 return out

# Public reset news stays separate from private account data.
NEWS = BASE/'reset-news.json'
NEWS_SENT = BASE/'reset-news-sent.json'
SITE = 'https://codex-reset.com/zh/'

def iso_time(value):
 from datetime import datetime
 try:return datetime.fromisoformat(str(value).replace('Z','+00:00')).timestamp()
 except (ValueError,TypeError,OverflowError):return 0

def source_url(value):
 import re
 return value if isinstance(value,str) and re.fullmatch(r'https://(?:x\.com|twitter\.com)/[A-Za-z0-9_]+/status/[0-9]+',value) else ''

def news_status(data, now):
 forecast=data.get('forecast') or {}
 if not isinstance(forecast,dict):forecast={}
 stale=bool(data.get('error')) or not 0<=now-data.get('updated',0)<=900 or not -60<=now-iso_time(forecast.get('updated_at'))<=900
 signal=forecast.get('official_signal')
 signal=signal if isinstance(signal,dict) else {}
 window=signal.get('window') or {}
 if not isinstance(window,dict):window={}
 at=iso_time(signal.get('at'));end=iso_time(window.get('end_at'))
 last=iso_time(forecast.get('last_reset_at'))
 summary=str(signal.get('summary') or '')[:700]
 label=str(window.get('label') or '')
 url=source_url(signal.get('url'))
 # Match the site's announced-window semantics; never promote its model odds.
 upcoming=bool(not stale and url and summary and 'banked' not in summary.lower() and label and 'timing unspecified' not in label.lower() and 0<=now-at<=7*86400 and last<at and now<end<=now+7*86400)
 message='Reset news unavailable or stale' if stale else 'Upcoming reset announced' if upcoming else 'Reset signal: timing unconfirmed' if signal and last<at and at<=now<at+86400 else 'No upcoming reset announced'
 return {'stale':stale,'upcoming':upcoming,'message':message,'summary':summary if upcoming else '', 'url':url,'end':end,'id':str(signal.get('tweet_id') or url), 'lastReset':time.strftime('%m-%d %H:%M %Z',time.localtime(last)) if last else 'Unknown','updated':data.get('updated',0),'source':SITE}

def fetch_news():
 BASE.mkdir(parents=True,exist_ok=True)
 with (BASE/'news.lock').open('w') as lock:
  try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
  except BlockingIOError:return
  data=load_json(NEWS,{})
  if time.time()<data.get('retryAfter',0) or time.time()-data.get('attempted',0)<60:return
  data['attempted']=time.time()
  from urllib.request import Request,urlopen
  from urllib.error import HTTPError
  try:
   req=Request('https://codex-reset.com/api/forecast',headers={'User-Agent':'end4-vendetta/1.0 (+https://github.com/zzxzzk115/dots-hyprland)'})
   with urlopen(req,timeout=8) as response:raw=response.read(512*1024+1)
   if len(raw)>512*1024:raise ValueError('Oversized response')
   forecast=json.loads(raw)
   if not isinstance(forecast,dict) or not iso_time(forecast.get('updated_at')):raise ValueError('Unknown schema')
   data.update(forecast=forecast,updated=time.time(),error=None,retryAfter=0)
  except HTTPError as error:
   data['error']='Reset news could not be refreshed'
   if error.code==429:
    retry=error.headers.get('Retry-After','300')
    from email.utils import parsedate_to_datetime
    try:delay=int(retry) if retry.isdigit() else parsedate_to_datetime(retry).timestamp()-time.time()
    except (ValueError,TypeError,OverflowError):delay=300
    data['retryAfter']=time.time()+max(60,delay)
  except Exception:data['error']='Reset news could not be refreshed'
  write_json(NEWS,data)
 remind_news()

def remind_news():
 now=time.time();prefs=preferences();news=news_status(load_json(NEWS,{}),now)
 if not prefs['enabled'] or prefs['snoozedUntil']>now or not news['upcoming']:return
 account=read()
 if account.get('error') or not 0<=now-account.get('updated',0)<=600:return
 remaining=max((w.get('remaining',0) for w in account.get('windows',[]) if (w.get('resetsAt') or 0)>now),default=0)
 if remaining<10:return
 with (BASE/'news-notify.lock').open('w') as lock:
  fcntl.flock(lock,fcntl.LOCK_EX)
  sent={k:v for k,v in load_json(NEWS_SENT,{}).items() if v>now}
  key=news['id']
  if key in sent:return
  body=f"An upcoming reset is reported; you still have usage available. Consider finishing useful work before the announced window ends in {countdown(news['end']-now)}.\nData: codex-reset.com\n{news['url']}"
  try:result=subprocess.run(['notify-send','--app-name=Codex','--icon=appointment-soon','Codex reset announcement',body],timeout=5)
  except (OSError,subprocess.TimeoutExpired):return
  if result.returncode==0:sent[key]=news['end'];write_json(NEWS_SENT,sent)

base_action=action

def action(name):
 if name in ('reset-site','reset-source'):
  url=SITE if name=='reset-site' else news_status(load_json(NEWS,{}),time.time())['url'] or SITE
  subprocess.Popen(['xdg-open',url]);return
 if name=='refresh':
  subprocess.run(['systemctl','--user','start','--no-block','codex-reset-news.service'],check=False)
 base_action(name)

base_status=status

def status():
 out=base_status();out['news']=news_status(load_json(NEWS,{}),time.time());return out

if __name__=='__main__':
 arg=sys.argv[1] if len(sys.argv)>1 else '--status'
 if arg=='--fetch':fetch();remind_news()
 elif arg=='--fetch-news':fetch_news()
 elif arg=='--refresh':action('refresh')
 elif arg=='--details':dialog()
 elif arg=='--action' and len(sys.argv)==3:action(sys.argv[2])
 else:print(json.dumps(status(),ensure_ascii=False))
