#!/usr/bin/env python3
import os,sys,json,subprocess
if 'hyprland' not in os.environ.get('XDG_CURRENT_DESKTOP','').lower():
 os.execv('/usr/bin/chatgpt',['chatgpt',*sys.argv[1:]])
if os.environ.get('XDG_CONFIG_HOME')==os.path.expanduser('~/.config/hypr/end4-session'):
 for key in ('XDG_CONFIG_HOME','XDG_STATE_HOME','XDG_CACHE_HOME'):os.environ.pop(key,None)
for key in ('LD_LIBRARY_PATH','QT_PLUGIN_PATH','QML_IMPORT_PATH','QML2_IMPORT_PATH','QT_QPA_PLATFORM','QT_QPA_PLATFORMTHEME'):
 os.environ.pop(key,None)
scale=1.666667
try:
 monitors=json.loads(subprocess.check_output(['hyprctl','-j','monitors'],text=True,timeout=3))
 scale=next((m['scale'] for m in monitors if m.get('focused')),monitors[0]['scale'])
except Exception:pass
os.execv('/usr/bin/chatgpt',['chatgpt','--ozone-platform=x11','--force-device-scale-factor='+str(scale),*sys.argv[1:]])
