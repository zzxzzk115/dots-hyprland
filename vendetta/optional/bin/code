#!/bin/sh
if [ "${XDG_CONFIG_HOME:-}" = "$HOME/.config/hypr/end4-session" ]; then
    unset XDG_CONFIG_HOME XDG_STATE_HOME XDG_CACHE_HOME
fi
unset LD_LIBRARY_PATH QT_PLUGIN_PATH QML_IMPORT_PATH QML2_IMPORT_PATH
case "${XDG_CURRENT_DESKTOP:-}" in
    *Hyprland*|*hyprland*) exec "$HOME/.local/opt/vscode-1.139.1/VSCode-linux-x64/bin/code" --ozone-platform=wayland "$@" ;;
esac
exec "$HOME/.local/opt/vscode-1.139.1/VSCode-linux-x64/bin/code" "$@"
